# Laravel's settings. On a server, keep APP_ENV=production and APP_DEBUG=false;
# for development, local and true. php artisan key:generate fills APP_KEY.
APP_NAME=Vaultwarphpen
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

# The log goes to storage/logs/laravel.log; LOG_LEVEL below sets its level.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# Vaultwarphpen adds no tables to Vaultwarden's database: keep these on file and sync.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Vaultwarden's settings, with its names and defaults. Its .env.template lists them all:
# https://github.com/dani-garcia/vaultwarden/blob/main/.env.template
# Where Vaultwarphpen differs: docs/configuration.md.

## The public address, with a path if it is served below one.
# DOMAIN=https://vault.example.com

## The data folder (database with SQLite, RSA key, attachments, Sends, icons, config.json),
## relative to the installation folder. SQLite at data/db.sqlite3 unless DATABASE_URL says otherwise.
# DATA_FOLDER=data
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/vaultwarden
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/vaultwarden

## Sign-ups and the admin panel at /admin (an Argon2 PHC string is safer than a plain token).
# SIGNUPS_ALLOWED=true
# ADMIN_TOKEN=

## Mail (invitations, two-step login by email, alerts).
# SMTP_HOST=smtp.example.com
# SMTP_FROM=vaultwarden@example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

## Single sign-on with OpenID Connect (docs/sso.md).
# SSO_ENABLED=false
# SSO_AUTHORITY=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=

## Live notifications: the daemon php artisan vaultwarden:notifications (docs/installation.md).
## The requests reach it through notifications.sock in the data folder unless this says otherwise.
# ENABLE_WEBSOCKET=true
# NOTIFICATIONS_SOCKET=unix:///path/to/notifications.sock

## Push notifications for the mobile apps through Bitwarden's relay.
# PUSH_ENABLED=false
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=

## Vaultwarden's log levels: trace, debug, info, warn, error or off.
# LOG_LEVEL=info
